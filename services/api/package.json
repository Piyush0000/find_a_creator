{
  "name": "@evoc/api",
  "version": "1.0.0",
  "private": true,
  "main": "./src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "test:brief": "tsx --env-file=../../.env ../../scripts/test-brief.ts",
    "test:day2": "tsx --env-file=../../.env ../../scripts/test-day2.ts",
    "test:day3": "tsx --env-file=../../.env ../../scripts/test-day3.ts",
    "test:sprint-day1": "tsx --env-file=../../.env ../../scripts/test-sprint-day1.ts",
    "test:sprint-day2": "tsx --env-file=../../.env ../../scripts/test-sprint-day2.ts",
    "test:r2-upload": "tsx --env-file=../../.env ../../scripts/test-r2-upload.ts",
    "test:settlement-cron": "tsx --env-file=../../.env ../../scripts/test-settlement-cron.ts",
    "test:comprehensive-live": "tsx --env-file=../../.env ../../scripts/test-comprehensive-live.ts",
    "test:day6": "tsx --env-file=../../.env ../../scripts/test-day6.ts",
    "test:whatsapp": "tsx --env-file=../../.env ../../scripts/test-whatsapp-wapi.ts",
    "build": "tsc",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "@evoc/database": "workspace:*",
    "@evoc/types": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.8.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
