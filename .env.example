# Database (PostgreSQL inside Docker on port 5433 to avoid Homebrew clash)
POSTGRES_USER=evoc_admin
POSTGRES_PASSWORD=evoc_secret_2026
POSTGRES_DB=evoc_creator_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://evoc_admin:evoc_secret_2026@localhost:5433/evoc_creator_db?schema=public"

# Cache & Queues (Redis)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# API & Security
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_evoc_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=evoc_cookie_secret_key_2026
CHECKOUT_WEBHOOK_SECRET=evoc_secure_webhook_secret_2026

# Cloudflare R2 Storage (Direct S3-Compatible Video Uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=evoc-creator-media
R2_PUBLIC_DOMAIN=https://media.evoclabs.com

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
