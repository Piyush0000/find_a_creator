# ==============================================================================
# EVOC Labs Creator Marketplace — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=evoc_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=evoc_creator_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://evoc_admin:your_secure_postgres_password_here@localhost:5432/evoc_creator_db?schema=public"

# ------------------------------------------------------------------------------
# 2. CACHE & QUEUES (Redis)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. BACKEND API & SECURITY
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Generate secure 64-character hex strings: `openssl rand -hex 32`
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
COOKIE_SECRET=generate_with_openssl_rand_hex_32

# Shared secret between D2C checkout system and EVOC to verify order webhooks
CHECKOUT_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# Comma-separated list of allowed origins for CORS (e.g. https://yourbrand.com,https://api.yourbrand.com)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4000"

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 OBJECT STORAGE (Reel Video Uploads)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=evoc-creator-media
R2_PUBLIC_DOMAIN=https://your-public-r2-domain.r2.dev

# ------------------------------------------------------------------------------
# 6. WHATSAPP NOTIFICATIONS (WAPI Gateway)
# ------------------------------------------------------------------------------
WAPI_BASE_URL="https://app.wapi.in.net/api"
WAPI_VENDOR_UID=your_wapi_vendor_uid
WAPI_TOKEN=your_wapi_token
