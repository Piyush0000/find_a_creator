{
  "name": "find-a-creator",
  "version": "1.0.0",
  "private": true,
  "description": "EVOC Labs UGC Creator Marketplace Platform",
  "author": "EVOC Labs Engineering",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "infra:up": "docker compose -f infra/docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.infra.yml down",
    "docker:all:up": "docker compose -f infra/docker-compose.yml up --build -d",
    "docker:all:down": "docker compose -f infra/docker-compose.yml down",
    "worker:dev": "pnpm --filter @evoc/worker dev",
    "db:generate": "pnpm --filter @evoc/database db:generate",
    "db:push": "pnpm --filter @evoc/database db:push",
    "db:migrate": "pnpm --filter @evoc/database db:migrate",
    "db:seed": "pnpm --filter @evoc/database db:seed",
    "db:studio": "pnpm --filter @evoc/database db:studio",
    "test:brief": "pnpm --filter @evoc/api test:brief",
    "test:day2": "pnpm --filter @evoc/api test:day2",
    "test:day3": "pnpm --filter @evoc/api test:day3",
    "test:sprint-day1": "pnpm --filter @evoc/api test:sprint-day1",
    "test:sprint-day2": "pnpm --filter @evoc/api test:sprint-day2",
    "test:r2-upload": "pnpm --filter @evoc/api test:r2-upload",
    "test:settlement-cron": "pnpm --filter @evoc/api test:settlement-cron",
    "test:comprehensive-live": "pnpm --filter @evoc/api test:comprehensive-live",
    "test:day6": "pnpm --filter @evoc/api test:day6"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.1"
}
